{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeybadger Check In API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Check In",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Submit a check-in for a scheduled task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeybadger.io/v1/check_in/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ],
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Submit a check-in for a scheduled task"
        }
      ]
    }
  ],
  "bundled": true
}
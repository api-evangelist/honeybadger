{
  "opencollection": "1.0.0",
  "info": {
    "name": "Honeybadger Check In Notices API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Notices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Report an exception",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.honeybadger.io/v1/notices",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "X-API-Key",
              "value": "{{X-API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Report an exception"
        }
      ]
    }
  ],
  "bundled": true
}